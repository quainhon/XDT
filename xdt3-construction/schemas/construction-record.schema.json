{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xdt.construction-record.v0.1",
  "title": "XDT3 Construction Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "build_plan",
    "authorization",
    "work_package_id",
    "target",
    "owner",
    "required_materials_contracts",
    "dependencies",
    "prerequisite_gates",
    "requested_outcome",
    "permitted_mutation_scope",
    "forbidden_scope",
    "execution_route",
    "acceptance_criteria",
    "implementation_evidence",
    "status",
    "blockers_escalations",
    "provenance",
    "xdt4_handoff"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "build_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_plan_id",
        "source_repo",
        "source_path",
        "source_revision",
        "source_schema_version"
      ],
      "properties": {
        "build_plan_id": {
          "type": "string",
          "minLength": 1
        },
        "source_repo": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_schema_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_authorized",
        "evidence"
      ],
      "properties": {
        "construction_authorized": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "work_package_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "repository",
        "path_scope"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_owner",
        "xdt3_is_target_owner"
      ],
      "properties": {
        "authoritative_owner": {
          "type": "string",
          "minLength": 1
        },
        "xdt3_is_target_owner": {
          "type": "boolean"
        }
      }
    },
    "required_materials_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisite_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_outcome": {
      "type": "string",
      "minLength": 1
    },
    "permitted_mutation_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "execution_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "lane",
        "delegate_to"
      ],
      "properties": {
        "mode": {
          "enum": [
            "direct_in_owned_scope",
            "handoff_to_owner",
            "refused"
          ]
        },
        "lane": {
          "type": "string",
          "minLength": 1
        },
        "delegate_to": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "implementation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims_are_verification",
        "commits",
        "tests",
        "artifacts"
      ],
      "properties": {
        "claims_are_verification": {
          "const": false
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "refused_unauthorized",
        "blocked",
        "prepared",
        "handoff_ready",
        "evidence_ready_for_xdt4"
      ]
    },
    "blockers_escalations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "xdt4_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "verification_status",
        "input_refs"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "verification_status": {
          "const": "not_verified"
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}