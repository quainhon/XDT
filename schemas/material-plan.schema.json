{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xdt.material-plan.v0.1",
  "title": "Material Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "status",
    "prepared_by",
    "reuse",
    "new_materials_required",
    "canonical_contracts",
    "ownership",
    "relationships",
    "consumers",
    "compatibility",
    "unresolved_decisions",
    "restrictions",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "approved",
        "approved_with_unresolved",
        "blocked"
      ]
    },
    "prepared_by": {
      "const": "XDT1-MATERIAL"
    },
    "reuse": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/materialRef"
      }
    },
    "new_materials_required": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/proposedMaterial"
      }
    },
    "canonical_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/materialRef"
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "owner",
          "status"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "known",
              "proposed",
              "unknown",
              "conflict"
            ]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "type",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "action"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "escalate_to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "escalate_to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "restrictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/evidenceRef"
      }
    }
  },
  "definitions": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "path",
        "revision"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "materialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/evidenceRef"
        }
      }
    },
    "proposedMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "ownership_status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "ownership_status": {
          "enum": [
            "proposed",
            "unknown",
            "conflict"
          ]
        }
      }
    }
  }
}